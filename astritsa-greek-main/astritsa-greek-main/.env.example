# Astritsa production configuration
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_DAYS=30

# AI provider — OpenAI-compatible chat completions API
AI_API_KEY=sk-n4W3qRCXIvlaxGshgcnQvI2aVD410Tw0Gi3pV4zktz83yqep
AI_MODEL=MiniMax M3.1 Flash
AI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.72

# Real-time astrology source aggregation
# Use only sources you have permission to use: official APIs, licensed feeds, allowed RSS feeds, or your own editorial feeds.
# Default source for development - replace with your own permitted sources before launch.
ASTRO_SOURCE_URLS=[{"name":"Official Astrology RSS","url":"https://example.com/rss","language":"en"}]
SOURCE_CACHE_SECONDS=600
# Default fallback source when no configured sources are available (development only)
# In production, configure your own permitted sources via the admin panel or ASTRO_SOURCE_URLS env var
FALLBACK_SOURCE_URL=https://astritsa-local-test-feed.rss
MAX_ASTRO_SOURCES=10
SOURCE_TIMEOUT_MS=7000
SOURCE_EXCERPT_CHARS=2400
AI_SOURCE_CONTEXT_CHARS=12000

# Per-sign sky endpoint (/api/sky/:sign) snapshot cache lifetime in ms.
SKY_CACHE_TTL_MS=600000

# Admin bootstrap
ADMIN_EMAIL=sakis@astritsa.com
ADMIN_PASSWORD=AstroFoteino27

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success#account
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancel#account
PAYMENTS_REQUIRED=false

# Optional consent-gated analytics/marketing tags.
# The ids are exposed via /api/config; the client injects gtag.js (analytics)
# / Meta Pixel (marketing) ONLY after the visitor grants the matching cookie consent.
# AI_API_KEY, AI_MODEL, and APP_ORIGIN are required for full functionality
# ANALYTICS_GA4_ID and MARKETING_PIXEL_ID are consent-gated (set via admin panel)
# See DEPLOY.md for full production setup

# Optional contact forwarding webhook; if omitted, messages are stored for admin review.
CONTACT_WEBHOOK_URL=
